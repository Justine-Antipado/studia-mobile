# Base URL of the PHP API. Empty means "same origin" (the dev proxy or the
# production host). Example: https://studia.omsu.edu.ph
VITE_API_URL=https://studia-api-mu.vercel.app

# true  -> in-memory mock backend (core/data/mock), no server needed
# false -> real HTTP calls through core/data/http/client.js
VITE_USE_MOCK=true

# Shown in the document title: "Users · STUDIA Admin"
VITE_APP_NAME=STUDIA Admin

# Minutes of inactivity before the portal signs the admin out (warning at 60s left)
VITE_SESSION_IDLE_MINUTES=20

# Admin login/logout always go to Supabase Auth + studia-api (no mock sign-in). All three are required.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sender address shown in Settings -> Email & OTP as the default. SMTP
# credentials live in the server's .env, never in this client bundle.
VITE_MAIL_FROM=studia.noreply2026@gmail.com
