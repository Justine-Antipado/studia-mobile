# Copy to .env (local only). NEVER commit real values. See docs/SETUP-CHECKLIST.md.

# ---- PUBLIC (safe in client bundles) ----
EXPO_PUBLIC_DATA_SOURCE=mock          # mock | remote   (studia-mobile)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=
VITE_DATA_SOURCE=mock                 # mock | remote   (studia-admin)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# ---- SERVER ONLY (studia-api on Vercel, scripts/). Never in a client .env ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                      # postgres connection string, used by scripts/ only
AI_API_KEY=                           # Anthropic key, server side only
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
