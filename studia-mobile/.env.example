# mock (default, in-memory) | remote (Supabase + studia-api)
EXPO_PUBLIC_DATA_SOURCE=mock
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth client ids (public). Web is REQUIRED (it is the token audience); iOS only for iOS builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
