{
  "expo": {
    "name": "studia-mobile",
    "slug": "studia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/images/studia-mobile-logo.png",
    "scheme": "studiamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/studia-mobile-logo.png",
      "bundleIdentifier": "com.group4.studiamobile"
    },
    "android": {
      "package": "com.group4.studiamobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID_SUFFIX"
        }
      ]
    ]
  }
}
