{
  "expo": {
    "name": "studia-mobile",
    "slug": "studia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/images/studia-mobile-logo.png",
    "scheme": "studiamobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/studia-mobile-logo.png",
      "bundleIdentifier": "com.group4.studiamobile"
    },
    "android": {
      "package": "com.group4.studiamobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/studia-mobile-logo.png",
          "color": "#ffffff"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.591672082298-fn2b59aem60h9i87ekv8729ecaf0pged"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Studia uses your photos so you can choose a profile picture.",
          "cameraPermission": "Studia uses the camera so you can take a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "502e6b1a-147a-46c3-b620-f28aa18e43c2"
      }
    }
  }
}
