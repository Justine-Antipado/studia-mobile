{
  "expo": {
    "name": "studia-mobile",
    "slug": "studia-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/images/studia-mobile-logo.png",
    "scheme": "studiamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/studia-mobile-logo.png",
      "bundleIdentifier": "com.group4.studiamobile"
    },
    "android": {
      "package": "com.group4.studiamobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.591672082298-fn2b59aem60h9i87ekv8729ecaf0pged"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "502e6b1a-147a-46c3-b620-f28aa18e43c2"
      }
    }
  }
}
